<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>dpplint – Digital Product Passport checks</title>
  <link rel="icon" href="/oyd-mark.svg" type="image/svg+xml">
  <style>
    :root { color-scheme: light dark;
            --fg: #1d2330; --muted: #5b6475; --line: #d9dde5; --field: #848c9a; --bg: #ffffff; --panel: #f5f7fa;
            --pass: #1f7a3f; --warn: #9a6500; --fail: #b3261e; --skip: #6b7280; --accent: #2457a6;
            --on-accent: #ffffff; --on-status: #ffffff; }
    @media (prefers-color-scheme: dark) {
      :root { --fg: #e8eaed; --muted: #a0a4aa; --line: #3a3d42; --field: #757b83; --bg: #151618; --panel: #202226;
              --pass: #6fcf8f; --warn: #e7b75f; --fail: #f28b82; --skip: #a0a4aa; --accent: #8ab4f8;
              --on-accent: #151618; --on-status: #151618; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--fg); background: var(--bg); }
    .wrap { max-width: 960px; margin: 0 auto; padding-left: 16px; padding-right: 16px; }
    main.wrap { padding-top: 32px; }
    h1 { font-size: 1.8rem; margin: 0 0 4px; }
    .brand { display: flex; align-items: center; gap: 9px; }
    .brand .mark { width: 15px; height: auto; display: block; }
    p.lead { color: var(--muted); margin: 0 0 24px; }
    form { display: flex; gap: 8px; flex-wrap: wrap; }
    input[type=url] { flex: 1 1 420px; padding: 10px 12px; font-size: 1rem; color: var(--fg); background: var(--bg);
                      border: 1px solid var(--field); border-radius: 6px; }
    input[type=url]::placeholder { color: var(--muted); opacity: 1; }
    button { padding: 10px 18px; font-size: 1rem; border: 0; border-radius: 6px; background: var(--accent); color: var(--on-accent); cursor: pointer; }
    button:disabled { opacity: .6; cursor: default; }
    .hint { color: var(--muted); font-size: .9rem; margin: 8px 0 0; }
    a { color: var(--accent); }
    .hint a { cursor: pointer; overflow-wrap: anywhere; }
    .scroll { overflow-x: auto; }
    #status { margin: 24px 0 8px; color: var(--muted); }
    .summary { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 16px; margin: 16px 0; }
    .summary strong { font-size: 1.2rem; }
    .notice { color: var(--muted); font-size: .9rem; margin-top: 8px; }
    table { width: 100%; border-collapse: collapse; margin-top: 8px; }
    th, td { text-align: left; vertical-align: top; padding: 8px; border-bottom: 1px solid var(--line); }
    th { font-size: .85rem; color: var(--muted); font-weight: 600; }
    td.id { white-space: nowrap; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85rem; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: .8rem; font-weight: 600; color: var(--on-status); }
    .passed { background: var(--pass); } .warning { background: var(--warn); } .failed { background: var(--fail); } .skipped { background: var(--skip); }
    ul.msg { margin: 4px 0 0; padding-left: 18px; color: var(--muted); font-size: .9rem; }
    footer { margin-top: 56px; padding: 24px 0 40px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
    footer .wrap { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    footer a { color: var(--muted); }
    footer .legal a { margin-right: 16px; }
    footer .funding { flex-basis: 100%; font-size: 13px; }
  </style>
</head>
<body>
<main class="wrap">
  <h1 class="brand"><img class="mark" src="/oyd-mark.svg" alt="" width="15" height="28">dpplint</h1>
  <p class="lead">Checks the digital product passport retrievable for a product identifier against the automated passport criteria of
    <a href="https://github.com/OwnYourData/dpp-criteria">dpp-criteria</a> (EN 18219, EN 18223 and related regulation).</p>

  <form id="form">
    <input type="url" id="productId" name="productId" required placeholder="https://… (product identifier from the data carrier)" value="<%= @product_id %>">
    <button type="submit" id="run">Check</button>
  </form>
  <p class="hint">Examples: <a class="example">https://dpp.oydapp.eu/01/09520123456788/21/000002</a> (with content integrity),
    <a class="example">https://dpp.oydapp.eu/01/09520123456788/21/000001</a></p>

  <div id="status"></div>
  <div id="result"></div>

</main>
<footer>
  <div class="wrap">
    <div>
      Results report automated checks only. They are no certification and establish no presumption of conformity.<br>
      Criteria: dpp-criteria <%= @criteria_ref %> ·
      <a href="/api-docs">API</a> ·
      <a href="https://github.com/OwnYourData/dpplint">Source</a><br>
      Operated by <a href="https://www.ownyourdata.eu/en/">OwnYourData</a>
    </div>
    <div class="legal">
      <a href="https://www.ownyourdata.eu/en/imprint/">Imprint</a>
      <a href="https://www.ownyourdata.eu/en/privacy-policy/">Privacy</a>
    </div>
    <div class="funding"><%= raw FundingNotice.html %></div>
  </div>
</footer>
<script>
  const form = document.getElementById("form");
  const input = document.getElementById("productId");
  const button = document.getElementById("run");
  const statusEl = document.getElementById("status");
  const resultEl = document.getElementById("result");
  const order = { failed: 0, warning: 1, passed: 2, skipped: 3 };
  const reasonLabels = { not_applicable: "not applicable", not_implemented: "not implemented", no_evidence: "no evidence",
                         needs_credentials: "needs credentials", not_sent: "not sent", unreachable: "unreachable", not_evaluated: "not evaluated" };
  const reasonLabel = (code) => reasonLabels[code] || code;
  const skippedText = (s) => {
    const parts = Object.entries(s.skipped_by_reason || {}).map(([code, n]) => `${n} ${reasonLabel(code)}`);
    return `${s.skipped} skipped${parts.length ? ": " + parts.join(", ") : ""}`;
  };

  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  const render = (d) => {
    const retrieval = d.retrieval || {};
    const rows = [...d.criteria].sort((a, b) => order[a.result] - order[b.result] || a.id.localeCompare(b.id)).map((c) => {
      const notes = (c.messages || []).map((m) => `<li>${esc(m.message)}</li>`).join("") + (c.reason ? `<li>${esc(c.reason)}</li>` : "");
      const proposed = c.counted === false ? ` <span class="notice">(${esc(c.status)}, not counted)</span>` : "";
      const id = c.description_url ? `<a href="${esc(c.description_url)}" target="_blank" rel="noopener" title="Description of the criterion">${esc(c.id)}</a>` : esc(c.id);
      return `<tr><td class="id">${id}</td><td>${esc(c.title)}${proposed}${notes ? `<ul class="msg">${notes}</ul>` : ""}</td>
              <td>${esc(c.level)}</td><td><span class="badge ${esc(c.result)}">${esc(c.result)}</span>${c.reason_code ? `<div class="notice">${esc(reasonLabel(c.reason_code))}</div>` : ""}</td></tr>`;
    }).join("");
    resultEl.innerHTML = `
      <div class="summary"><strong>${esc(d.summary.text)}</strong>
        (${d.summary.failed} failed, ${d.summary.warnings} with warnings, ${esc(skippedText(d.summary))})
        ${d.summary.proposed_not_counted ? `<div class="notice">Proposed criteria, not counted: ${esc(d.summary.proposed_not_counted.text)}</div>` : ""}
        <div class="notice" style="overflow-wrap:anywhere">Retrieved: ${esc(retrieval.url)} · HTTP ${esc(retrieval.status)} · ${esc(retrieval.contentType)}${retrieval.error ? " · " + esc(retrieval.error) : ""}</div>
        <div class="notice">${esc(d.notice)}</div></div>
      <div class="scroll"><table><thead><tr><th>Criterion</th><th>Requirement and findings</th><th>Level</th><th>Result</th></tr></thead><tbody>${rows}</tbody></table></div>`;
  };

  const run = async (productId) => {
    button.disabled = true;
    resultEl.innerHTML = "";
    statusEl.textContent = "Retrieving and checking the passport …";
    history.replaceState(null, "", "?productId=" + encodeURIComponent(productId));
    try {
      const res = await fetch("/api/v1/validate/" + productId, { headers: { Accept: "application/json" } });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "HTTP " + res.status);
      statusEl.textContent = "";
      render(data);
    } catch (e) {
      statusEl.textContent = "The check could not be run: " + e.message;
    } finally {
      button.disabled = false;
    }
  };

  form.addEventListener("submit", (e) => { e.preventDefault(); run(input.value.trim()); });
  document.querySelectorAll(".example").forEach((a) => a.addEventListener("click", (e) => { input.value = e.target.textContent; run(input.value); }));
  if (input.value) run(input.value);
</script>
</body>
</html>
